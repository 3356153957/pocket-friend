# Mobile public configuration. Values prefixed with EXPO_PUBLIC_ are visible to clients.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GATEWAY_URL=http://localhost:4310
EXPO_PUBLIC_ENABLE_JACOO=false
# Public browser values. Restrict allowed domains in the AMap console.
EXPO_PUBLIC_AMAP_KEY=
EXPO_PUBLIC_AMAP_SECURITY_JS_CODE=

# Optional mobile demo selection. Photo and avatar credentials remain server-only.
VITE_PHOTO_API_BASE_URL=/photo-api
VITE_DEMO_PHOTO_NAME=

# Gateway-only development configuration. Never expose these values to the mobile app.
PF_ENABLE_JACOO=false
JACOO_BASE_URL=
JACOO_API_KEY=
PF_ALLOWED_ORIGIN=http://localhost:8081
PF_PRODUCT_STORE_FILE=./data/product-state.json
PF_PRODUCT_API_TOKEN=
PF_GATEWAY_MAX_BODY_BYTES=4194304
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seedream-5-0-260128
# Optional HTTPS override; defaults to the Volcengine Ark image generation endpoint.
DOUBAO_ENDPOINT=
PORT=4310

# Independent device-status admin. Keep credentials and tokens server-only.
ADMIN_HOST=0.0.0.0
ADMIN_PORT=4311
PF_ADMIN_USERNAME=operator
PF_ADMIN_PASSWORD=
PF_DEVICE_HEARTBEAT_TOKEN=
# Days to keep uploaded visitor photos before automatic deletion. Empty keeps them.
PF_PHOTO_RETENTION_DAYS=7
# Used only by the Vite development proxy when reading photo history.
PF_PHOTO_TOKEN=
# Vite development proxy target. Plain HTTP is accepted only for loopback.
PF_PHOTO_API_URL=http://127.0.0.1:4311
# Production static proxy targets (loopback services by default).
PF_GATEWAY_ORIGIN=http://127.0.0.1:4310
PF_PHOTO_API_ORIGIN=http://127.0.0.1:4311
# Optional comma-separated exact origins. Defaults to the admin request hostname.
PF_WEB_ORIGIN=
VITE_ADMIN_URL=
